{
  "name": "claude-web",
  "private": true,
  "version": "0.1.5",
  "license": "MIT",
  "repository": "github:ypyik0669/claude-web",
  "type": "module",
  "main": "desktop/dist/main.js",
  "workspaces": [
    "server",
    "web",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm test -w server && npm test -w web && npm test -w desktop",
    "build:all": "npm run build -w server && npm run build -w web && npm run build -w desktop",
    "desktop": "npm run build:all && electron .",
    "build:desktop": "npm run build:all && electron-builder --config electron-builder.yml --win",
    "build:desktop:mac": "npm run build:all && electron-builder --config electron-builder.yml --mac",
    "build:desktop:linux": "npm run build:all && electron-builder --config electron-builder.yml --linux",
    "typecheck": "tsc --noEmit -p server && tsc --noEmit -p web && tsc --noEmit -p desktop",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@larksuiteoapi/node-sdk": "^1.73.1",
    "chokidar": "^5.0.0",
    "claude-code-best": "^2.8.4",
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "node-datachannel": "^0.33.4",
    "node-pty": "^1.1.0",
    "smol-toml": "^1.9.0",
    "undici": "^7.30.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
