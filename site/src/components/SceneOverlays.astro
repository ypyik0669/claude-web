---
import { copy } from '../copy';
import type { Locale } from '../i18n';
import { DIFF, diffStat, TEST_OUTPUT, TURN_STEPS } from '../hero/samples';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = copy(locale).scene;
const stat = diffStat(DIFF);
---
<div class="scene-overlays" data-overlays>
  <div class="ov ov-turns" data-overlay="turns" hidden>
    <button class="ov-turn" type="button" aria-expanded="false" data-turn><span class="ov-dot" aria-hidden="true"></span>{s.turn.summary}</button>
    <ol class="ov-timeline" data-timeline hidden>
      {TURN_STEPS.map((step) => <li><span class="glyph" aria-hidden="true"></span><code>{step}</code></li>)}
      <li class="ov-code">
        <pre><code>npm test</code></pre>
        <button class="btn btn-small" type="button" data-run>{s.turn.run}</button>
        <pre class="ov-out" data-out hidden>{TEST_OUTPUT}</pre>
      </li>
    </ol>
  </div>

  <div class="ov ov-permission" data-overlay="permission" role="group" aria-labelledby="ov-perm-t" hidden>
    <p class="ov-badge">{s.permission.badge}</p>
    <p class="ov-title" id="ov-perm-t">{s.permission.title}</p>
    <pre><code>npm test</code></pre>
    <div class="ov-actions">
      <button class="btn btn-primary" type="button" data-decide="allow">{s.permission.allow}</button>
      <button class="btn" type="button" data-decide="deny">{s.permission.deny}</button>
    </div>
    <p class="ov-result" data-result aria-live="polite" data-allowed={s.permission.allowed} data-denied={s.permission.denied}></p>
  </div>

  <div class="ov ov-review" data-overlay="review" hidden>
    <button class="ov-file" type="button" aria-expanded="false" data-file>
      <span>{s.review.card}</span><span class="add">+{stat.add}</span><span class="del">−{stat.del}</span>
    </button>
    <div class="ov-diff" data-diff hidden>
      {DIFF.map((f) => (
        <div class="ov-diff-file">
          <p>{f.file}</p>
          <pre>{f.lines.map((l) => <span class={`l-${l.kind}`}>{(l.kind === 'add' ? '+' : l.kind === 'del' ? '-' : ' ') + l.text}</span>)}</pre>
        </div>
      ))}
    </div>
  </div>

  <div class="ov ov-receipt" data-overlay="checkout" hidden>
    <p class="ov-title">{s.receipt.title}</p>
    <p>{s.receipt.took}</p>
    <p>{s.receipt.tab}</p>
    <p>18.9k token · $0.06</p>
  </div>

  <div class="ov ov-elsewhere" data-overlay="elsewhere" hidden>
    <ul class="ov-chips">
      <li>{s.elsewhere.other}</li>
    </ul>
    <div class="ov-phone" aria-hidden="true"><span></span><span></span><span></span></div>
    <p>{s.elsewhere.phone}</p>
  </div>
</div>
