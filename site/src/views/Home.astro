---
import Base from '../layouts/Base.astro';
import DownloadButtons from '../components/DownloadButtons.astro';
import SceneOverlays from '../components/SceneOverlays.astro';
import Showcase from '../showcase/Showcase.astro';
import data from '../data/site-data.json';
import { copy } from '../copy';
import { readmeLink } from '../readme';
import type { SiteData } from '../data/releases';
import type { Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy(locale);
const d = data as SiteData;
const base = import.meta.env.BASE_URL;
const num = (n: number) => n.toLocaleString(locale === 'zh' ? 'zh-CN' : 'en-US');
const stats = [
  d.stars != null ? { n: num(d.stars), label: c.stats.stars } : null,
  d.releases != null ? { n: num(d.releases), label: c.stats.releases } : null,
].filter((s) => s !== null);
---
<Base locale={locale} page="home">
  <div class="stage" id="stage">
    <div class="stage-scene" id="hero-scene">
      <img class="scene-poster" src={`${base}poster/${locale}.webp`} width="1440" height="900" alt="" fetchpriority="high" />
      <div class="scene-a11y" role="img" aria-label={c.meta.sceneAlt} data-scene-label-el></div>
      <div class="scene-tip" role="status" data-doing={JSON.stringify(c.scene.doing)} hidden></div>
      <button class="scene-sound" type="button" data-key-action="sound" aria-keyshortcuts="S" aria-pressed="false" data-on={c.scene.sound.on} data-off={c.scene.sound.off}><span data-sound-label>{c.scene.sound.off}</span><kbd aria-hidden="true">S</kbd></button>
      <div class="scene-debug" data-debug hidden>
        <p>{c.scene.debug.title}</p>
        <label>{c.scene.debug.speed} <input type="range" min="0.25" max="4" step="0.25" value="1" data-speed /></label>
        <label>{c.scene.debug.seed} <input type="number" min="1" max="99999" value="7" data-seed /></label>
        <button class="btn btn-small" type="button" data-reseed>{c.scene.debug.reseed}</button>
        <output data-fps>0 fps</output>
      </div>
    </div>

    <section class="hero" data-hero aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">{c.hero.title}</h1>
        <p class="hero-sub">{c.hero.sub}</p>
        <DownloadButtons locale={locale} />
        <p class="hero-fine">{c.hero.fine}</p>
        <p class="hero-hint" aria-hidden="true">{c.hero.hint} ↓</p>
      </div>
    </section>

    <div id="features" class="chapters">
      {c.chapters.map((ch, i) => (
        <section class="chapter" id={`ch-${ch.id}`} data-chapter={ch.id} data-scene-label={c.scene.labels[ch.id]} aria-labelledby={`ch-${ch.id}-t`}>
          <div class="chapter-card">
            <p class="chapter-n">{String(i + 1).padStart(2, '0')}</p>
            <h2 id={`ch-${ch.id}-t`}>{ch.title}</h2>
            <p>{ch.body}</p>
            <a class="chapter-more" href={readmeLink(locale, ch.readme)}>{c.chapterMore} →</a>
          </div>
        </section>
      ))}
    </div>
    {/* after the chapters, so Tab from a chapter reaches its card's buttons; sticky over the stage like the scene */}
    <SceneOverlays locale={locale} />
  </div>

  <Showcase locale={locale} />
  <section class="stats" aria-label={c.stats.label}>
    {stats.map((s) => <div><strong>{s.n}</strong><span>{s.label}</span></div>)}
  </section>

  <section class="install" id="install" aria-labelledby="install-t">
    <h2 id="install-t">{c.install.title}</h2>
    <p>{c.install.body}</p>
    <DownloadButtons locale={locale} />
  </section>
  <script>
    import '../hero/entry';
  </script>
</Base>
